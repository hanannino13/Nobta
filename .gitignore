.expo/
.expo-shared/
web-build/
expo-env.d.ts
apps/mobile/android/
apps/mobile/ios/
*.apk
*.aab
*.ipa
.metro-health-check*

# ---- Vite / admin ----
apps/admin/dist/

# ---- Laravel / PHP ----
backend/vendor/
backend/node_modules/
backend/public/build/
backend/public/hot
backend/public/storage
